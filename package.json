{
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "7.1.9",
    "onnxruntime-web": "^1.22.0-dev.20250409-89f8206ba4"
  },
  "description": "English pronunciation trainer: play correct pronunciation at 3 speeds, record and score your reading with IPA phoneme feedback. No Google packages.",
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "name": "english-pronunciation-trainer",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "android:prepare": "bash scripts/prepare-capacitor.sh",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "build:cet4": "python3 scripts/build-cet4.py"
  },
  "type": "module",
  "version": "1.0.0"
}
